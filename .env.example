# ---- Portal ----
PORTAL_URL=http://localhost:3010
PORTAL_PORT=3010
SESSION_SECRET=change-me-32-bytes-min
SESSION_TTL_MINUTES=30
NODE_ENV=development           # set to "production" behind TLS + a real proxy

# ---- SMTP ingress (submission port the gateway listens on) ----
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=2525
GATEWAY_USER=devsender
GATEWAY_PASS=devpass

# ---- Mail mode ----
# console = log outbound instead of sending (default for local dev)
# smtp    = actually deliver via the outbound relay below
MAIL_MODE=console

# ---- Outbound relay (any authenticated SMTP: Zoho, Postmark, SES, etc.) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=relay@example.com
SMTP_PASS=REPLACE_WITH_APP_PASSWORD
FROM_NAME=Secure Messages
FROM_EMAIL=secure@example.com

# ---- Encryption ----
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MESSAGE_KEY_HEX=REPLACE_64_HEX_CHARS

# ---- Attachments ----
STORAGE_ROOT=./storage
MAX_ATTACHMENT_MB=25
MAX_TOTAL_MB=40

# ---- Message + OTP lifecycle ----
MESSAGE_TTL_HOURS=168          # 7 days
OTP_TTL_MINUTES=10
TRIGGER_KEYWORD=[secure]
